{
  "server": {
    "port": 6868,
    "host": "0.0.0.0",
    "name": "cowork-mcp",
    "version": "1.0.0",
    "apiKey": null
  },
  "paths": {
    "agencyAgents": "../agency-agents",
    "inbox": "./inbox",
    "reports": "./reports",
    "skills": "./skills",
    "status": "./.status",
    "decisions": "./decisions"
  },
  "platforms": {
    "claude": {
      "enabled": true,
      "agentsDir": "~/.claude/agents",
      "color": "#D97757"
    },
    "hermes": {
      "enabled": true,
      "skillsDir": "../hermes-agent/skills",
      "color": "#7C3AED"
    },
    "antigravity": {
      "enabled": true,
      "skillsDir": "~/.gemini/config/skills",
      "color": "#0EA5E9"
    }
  },
  "services": {
    "vllm35b": {
      "url": "http://localhost:8000/v1",
      "enabled": false
    },
    "vllm27b": {
      "url": "http://localhost:8001/v1",
      "enabled": false
    },
    "firecrawl": {
      "url": "http://localhost:3002",
      "enabled": false
    },
    "twseMcp": {
      "url": "http://localhost:8082/mcp",
      "enabled": false
    }
  },
  "inbox": {
    "autoArchiveDays": 30,
    "maxRetries": 3
  },
  "orchestration": {
    "enabled": true,
    "maxConcurrent": 2,
    "pollIntervalMs": 5000,
    "taskTimeoutMs": 1800000,
    "defaultRole": "generalist",
    "remoteGraceMs": 60000,
    "classifier": {
      "enabled": true,
      "exec": "hermes",
      "model": "nvidia/Qwen3.6-35B-A3B-NVFP4",
      "fallbackRole": "generalist",
      "timeoutMs": 180000
    },
    "staleClaimMs": 1800000,
    "defaultChain": [
      "local-ha-qwen35b",
      "local-ha-deepseek",
      "local-cc-opus"
    ],
    "divisionChains": {},
    "agents": {
      "orchestrator": {
        "description": "Decompose a CEO idea into role-tagged subtasks and dispatch them",
        "brains": [
          "remote-ai-code-gen-cc-fable",
          "local-ha-qwen35b",
          "local-ha-deepseek"
        ]
      },
      "generalist": {
        "description": "Fallback when the router can't classify or a roster agent fails through its chain",
        "brains": [
          "local-ha-qwen35b",
          "local-ha-deepseek"
        ]
      },
      "video": {
        "description": "Short vertical promo/shorts video via the ComfyUI LTX pipeline",
        "brains": [
          "local-comfy-ltx"
        ]
      }
    },
    "brains": {
      "local-ha-qwen35b": {
        "description": "local-ha-qwen35b (auto-registered by hermes-agent-wayne)",
        "location": "local",
        "exec": "hermes",
        "model": "nvidia/Qwen3.6-35B-A3B-NVFP4",
        "dynamic": true,
        "registeredBy": "b27e60cf-e3ec-4a2a-8215-70759a53b33f"
      },
      "local-ha-deepseek": {
        "description": "local-ha-deepseek (auto-registered by hermes-agent-wayne)",
        "location": "local",
        "exec": "hermes",
        "model": "deepseek:deepseek-v4-flash",
        "dynamic": true,
        "registeredBy": "b27e60cf-e3ec-4a2a-8215-70759a53b33f"
      },
      "local-cc-opus": {
        "description": "Local Claude Code using Opus 4.8",
        "location": "local",
        "exec": "claude",
        "model": "claude-opus-4-8"
      },
      "local-cc-sonnet": {
        "description": "Local Claude Code using Sonnet 5",
        "location": "local",

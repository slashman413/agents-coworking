{
  "server": {
    "port": 4200,
    "host": "0.0.0.0",
    "name": "cowork-mcp",
    "version": "1.0.0",
    "apiKey": null
  },
  "paths": {
    "agencyAgents": "../agency-agents",
    "inbox": "./inbox",
    "reports": "./reports",
    "skills": "./skills",
    "status": "./.status",
    "decisions": "./decisions"
  },
  "platforms": {
    "claude": {
      "enabled": true,
      "agentsDir": "~/.claude/agents",
      "color": "#D97757"
    },
    "hermes": {
      "enabled": true,
      "skillsDir": "../hermes-agent/skills",
      "color": "#7C3AED"
    },
    "antigravity": {
      "enabled": true,
      "skillsDir": "~/.gemini/config/skills",
      "color": "#0EA5E9"
    }
  },
  "services": {
    "vllm35b": {
      "url": "http://localhost:8000/v1",
      "enabled": false
    },
    "vllm27b": {
      "url": "http://localhost:8001/v1",
      "enabled": false
    },
    "firecrawl": {
      "url": "http://localhost:3002",
      "enabled": false
    },
    "twseMcp": {
      "url": "http://localhost:8082/mcp",
      "enabled": false
    }
  },
  "inbox": {
    "autoArchiveDays": 30,
    "maxRetries": 3
  },
  "orchestration": {
    "enabled": true,
    "maxConcurrent": 2,
    "pollIntervalMs": 5000,
    "taskTimeoutMs": 1800000,
    "defaultRole": "generalist",
    "roles": {
      "orchestrator": {
        "exec": "claude",
        "model": "claude-opus-4-8"
      },
      "orchestrator-fable": {
        "exec": "claude",
        "model": "claude-fable-5"
      },
      "engineer": {
        "exec": "claude",
        "model": "claude-opus-4-8",
        "fallback": "engineer-local"
      },
      "engineer-local": {
        "exec": "hermes",
        "model": "deepseek:deepseek-v4-flash",
        "fallback": "generalist"
      },
      "planner": {
        "exec": "hermes",
        "model": "nvidia/Qwen3.6-35B-A3B-NVFP4",
        "fallback": "generalist"
      },
      "researcher": {
        "exec": "hermes",
        "model": "nvidia/Qwen3.6-27B-NVFP4",
        "fallback": "generalist"
      },
      "sales": {
        "exec": "hermes",
        "model": "nvidia/Qwen3.6-35B-A3B-NVFP4",
        "fallback": "generalist"
      },
      "marketing": {
        "exec": "hermes",
        "model": "nvidia/Qwen3.6-35B-A3B-NVFP4",
        "fallback": "generalist"
      },
      "generalist": {
        "exec": "hermes",
        "model": "nvidia/Qwen3.6-35B-A3B-NVFP4"
      },
      "antigravity": {
        "exec": "agy",
        "model": ""
      }
    }
  }
}
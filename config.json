{
  "server": {
    "port": 4200,
    "host": "0.0.0.0",
    "name": "cowork-mcp",
    "version": "1.0.0",
    "apiKey": null
  },
  "paths": {
    "agencyAgents": "../agency-agents",
    "inbox": "./inbox",
    "reports": "./reports",
    "skills": "./skills",
    "status": "./.status",
    "decisions": "./decisions"
  },
  "platforms": {
    "claude": {
      "enabled": true,
      "agentsDir": "~/.claude/agents",
      "color": "#D97757"
    },
    "hermes": {
      "enabled": true,
      "skillsDir": "../hermes-agent/skills",
      "color": "#7C3AED"
    },
    "antigravity": {
      "enabled": true,
      "skillsDir": "~/.gemini/config/skills",
      "color": "#0EA5E9"
    }
  },
  "services": {
    "vllm35b": {
      "url": "http://localhost:8000/v1",
      "enabled": false
    },
    "vllm27b": {
      "url": "http://localhost:8001/v1",
      "enabled": false
    },
    "firecrawl": {
      "url": "http://localhost:3002",
      "enabled": false
    },
    "twseMcp": {
      "url": "http://localhost:8082/mcp",
      "enabled": false
    }
  },
  "inbox": {
    "autoArchiveDays": 30,
    "maxRetries": 3
  },
  "orchestration": {
    "enabled": true,
    "maxConcurrent": 2,
    "pollIntervalMs": 5000,
    "taskTimeoutMs": 1800000,
    "defaultRole": "generalist",
    "classifier": {
      "enabled": true,
      "exec": "hermes",
      "model": "nvidia/Qwen3.6-35B-A3B-NVFP4",
      "fallbackRole": "generalist",
      "timeoutMs": 180000
    },
    "staleClaimMs": 1800000,
    "agents": {
      "orchestrator": {
        "description": "Decompose a CEO idea into role-tagged subtasks and dispatch them",
        "brains": [
          "local-ha-qwen35b",
          "local-ha-deepseek",
          "local-cc-sonnet"
        ]
      },
      "engineer": {
        "description": "Write/refactor code, UI, technical implementation",
        "brains": [
          "local-cc-opus",
          "local-ha-deepseek",
          "local-ha-qwen35b"
        ]
      },
      "engineer-local": {
        "description": "Write/refactor code on a cheaper local model",
        "brains": [
          "local-ha-deepseek",
          "local-ha-qwen35b"
        ]
      },
      "planner": {
        "description": "Product planning, roadmaps, breaking work into steps",
        "brains": [
          "local-ha-qwen35b",
          "local-ha-deepseek"
        ]
      },
      "researcher": {
        "description": "Deep research, market/competitive analysis",
        "brains": [
          "local-ha-qwen27b",
          "local-ha-qwen35b"
        ]
      },
      "sales": {
        "description": "Pricing, monetization, outreach",
        "brains": [
          "local-ha-qwen35b",
          "local-ha-deepseek"
        ]
      },
      "marketing": {
        "description": "Copy, campaigns, positioning, social",
        "brains": [
          "local-ha-qwen35b",
          "local-ha-deepseek"
        ]
      },
      "generalist": {
        "description": "Anything that doesn't fit another agent",
        "brains": [
          "local-ha-qwen35b",
          "local-ha-deepseek"
        ]
      },
      "video": {
        "description": "Short vertical promo/shorts video via the ComfyUI LTX pipeline",
        "brains": [
          "local-comfy-ltx"
        ]
      },
      "antigravity": {
        "description": "Antigravity (AGY) agent",
        "brains": [
          "local-agy"
        ]
      }
    },
    "brains": {
      "local-ha-qwen35b": {
        "description": "Local Hermes Agent using Qwen3.6-35B-A3B (local vLLM :8000)",
        "location": "local",
        "exec": "hermes",
        "model": "nvidia/Qwen3.6-35B-A3B-NVFP4"
      },
      "local-ha-qwen27b": {
        "description": "Local Hermes Agent using Qwen3.6-27B (local vLLM :8001)",
        "location": "local",
        "exec": "hermes",
        "model": "nvidia/Qwen3.6-27B-NVFP4"
      },
      "local-ha-deepseek": {
        "description": "Local Hermes Agent using deepseek-v4-flash (cloud model)",
        "location": "local",
        "exec": "hermes",
        "model": "deepseek:deepseek-v4-flash"
      },
      "local-cc-opus": {
        "description": "Local Claude Code using Opus 4.8",
        "location": "local",
        "exec": "claude",
        "model": "claude-opus-4-8"
      },
      "local-cc-sonnet": {
        "description": "Local Claude Code using Sonnet 5",
        "location": "local",
        "exec": "claude",
        "model": "claude-sonnet-5"
      },
      "local-cc-fable": {
        "description": "Local Claude Code using Fable 5",
        "location": "local",
        "exec": "claude",
        "model": "claude-fable-5"
      },
      "local-agy": {
        "description": "Local Antigravity (AGY) CLI, account default model",
        "location": "local",
        "exec": "agy",
        "model": ""
      },
      "local-comfy-ltx": {
        "description": "Local ComfyUI LTX video pipeline (short vertical promo)",
        "location": "local",
        "exec": "script",
        "command": [
          "/home/wayne/workspace/github/slashman413/agents-coworking/deploy/video-pipeline.sh"
        ]
      },
      "remote-aicodegen-cc-fable": {
        "description": "Remote MCP client on host 'aicodegen' running Claude using Fable",
        "location": "remote",
        "host": "aicodegen",
        "exec": "claude",
        "model": "claude-fable-5"
      }
    }
  }
}
# Systemd *template* unit for a remote-brain client — install on the REMOTE machine.
# One config file per brain: ~/.config/cowork-remote-brain/<name>.env
# Start with:  systemctl --user enable --now cowork-remote-brain@<name>
# Scale by adding more <name>.env files and starting more instances.
#
#   mkdir -p ~/.config/cowork-remote-brain
#   cp remote-brain-client.env.example ~/.config/cowork-remote-brain/fable.env  # then edit
#   cp cowork-remote-brain@.service    ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now cowork-remote-brain@fable

[Unit]
Description=Cowork remote-brain client (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/.config/cowork-remote-brain/%i.env
# COWORK_CLIENT_JS is set in the env file to the absolute path of the script.
ExecStart=/usr/bin/env sh -c 'exec node "$COWORK_CLIENT_JS"'
Restart=always
RestartSec=5

[Install]
WantedBy=default.target

# Config for a remote-brain client (deploy/remote-brain-client.mjs).
# Copy to ~/.config/cowork-remote-brain/<name>.env on the remote machine and edit.
# The SAME script serves any brain — only these values change per machine/brain.

# Cowork server (LAN or Tailscale IP of the box running cowork-mcp)
COWORK_URL=http://100.80.243.33:4200

# This machine's brain alias — MUST match an entry in the server's
# config.json → orchestration.brains (location: remote).
BRAIN_ID=remote-aicodegen-cc-fable

# How this machine runs the work locally:
EXEC=claude
MODEL=claude-fable-5

# Only if the server sets server.apiKey / COWORK_API_KEY:
# COWORK_API_KEY=your-shared-key

# Optional tuning:
# POLL_MS=5000
# MAX_CONCURRENT=1
# TASK_TIMEOUT_MS=1800000
# AGENT_NAME=remote-aicodegen-cc-fable

# Absolute path to the client script on this machine (used by the systemd unit):
# COWORK_CLIENT_JS=/home/USER/agents-coworking/deploy/remote-brain-client.mjs

# Config for a remote-brain client (deploy/remote-brain-client.mjs).
# Copy to ~/.config/cowork-remote-brain/<name>.env on the remote machine and edit.
# The SAME script serves any brains — only these values change per machine.

# Cowork server (LAN or Tailscale IP of the box running cowork-mcp)
COWORK_URL=http://<cowork-host>:6868

# This machine + default executor. Brains you declare are AUTO-REGISTERED into
# the server's brain registry on connect (and removed only via the UI or a clean
# deregister — never on heartbeat timeout).
HOST=aicodegen
EXEC=claude

# Declare every model this machine can run. Each becomes a brain the orchestrator
# can target and agents can put in their fallback chains.
BRAINS=[{"id":"remote-aicodegen-cc-opus","model":"claude-opus-4-8"},{"id":"remote-aicodegen-cc-sonnet","model":"claude-sonnet-5"},{"id":"remote-aicodegen-cc-fable","model":"claude-fable-5"}]

# Only if the server sets server.apiKey / COWORK_API_KEY:
# COWORK_API_KEY=your-shared-key

# Optional tuning:
# POLL_MS=5000
# MAX_CONCURRENT=1
# TASK_TIMEOUT_MS=9000000
# AGENT_NAME=aicodegen

# Antigravity (agy) rate-limit meter — only needed when auto-discovery fails.
# The probe finds credentials by itself from ~/.gemini (user_refresh.antigravity
# or oauth_creds.json) and mints access tokens via the standard Google OAuth
# refresh grant. Override any step of that ladder here:
# AGY_ACCESS_TOKEN=ya29...            # ready-to-use bearer (highest priority)
# AGY_TOKEN_FILE=/path/creds.json     # JSON with access_token and/or refresh_token
# AGY_REFRESH_TOKEN=1//...            # refresh token to mint access tokens from
# AGY_CLIENT_ID=...                   # OAuth client override (defaults to the
# AGY_CLIENT_SECRET=...               #  public Gemini-CLI installed-app client)

# Absolute path to the client script on this machine (used by the systemd unit):
# COWORK_CLIENT_JS=/home/USER/cowork/deploy/remote-brain-client.mjs

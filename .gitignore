node_modules/
dist/
.status/agents.json
*.log
.DS_Store
inbox/*.json
decisions/*.md
# Server-owned runtime data: the lesson ledger (WF-1), env-access log (WF-4), and
# human-approved routing rules / per-agent playbooks (WF-2). These are per-server
# state, not source — never commit them.
decisions/*.jsonl
decisions/routing-rules.json
decisions/playbooks/
server/hermes-*.md
docs/backlink-*.md
artifacts/
inputs/
workflow-runs/

# Scratch/debug scripts — the server is TypeScript; stray .py files are local-only
# and have leaked private paths before. Keep them out of git. Dispatched agents
# occasionally drop working files (scripts, sqlite dbs, ComfyUI graphs) in the repo
# root despite the per-task cwd; ignore those at the ROOT only, so a real file in a
# subdirectory is never silently hidden.
server/*.py
/*.py
/*.db
/__pycache__/
